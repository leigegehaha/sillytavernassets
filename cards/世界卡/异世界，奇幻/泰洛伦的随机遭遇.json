: true, "depth": 2, "group": "小事件", "groupOverride": false, "groupWeight": 100, "scanDepth": null, "caseSensitive": null, "matchWholeWords": null, "useGroupScoring": null, "automationId": "", "role": 0, "sticky": 2, "cooldown": 3, "delay": 0, "displayIndex": 13, "characterFilter": {"isExclude": false, "names": [], "tags": []}}, "14": {"uid": 14, "key": ["小事件"], "keysecondary": [], "comment": "匪徒袭击", "content": "命令，将剧情导往该随机小事件。\n  - [起因: 商队在某处遭匪徒袭击]-[承接: 公会发布高额救援任务]-[转折: 你发现匪徒是竞争的商会雇佣的，任务发布者是幕后黑手]-[结束: 你的任务从救援幸存者，变成了抹除所有知情人]", "constant": false, "vectorized": false, "selective": true, "selectiveLogic": 0, "addMemo": true, "order": 100, "position": 4, "disable": false, "excludeRecursion": false, "preventRecursion": false, "matchPersonaDescription": false, "matchCharacterDescription": false, "matchCharacterPersonality": false, "matchCharacterDepthPrompt": false, "matchScenario": false, "matchCreatorNotes": false, "delayUntilRecursion": true, "probability": 100, "useProbability": true, "depth": 2, "group": "小事件", "groupOverride": false, "groupWeight": 100, "scanDepth": null, "caseSensitive": null, "matchWholeWords": null, "useGroupScoring": null, "automationId": "", "role": 0, "sticky": 2, "cooldown": 3, "delay": 0, "displayIndex": 14, "characterFilter": {"isExclude": false, "names": [], "tags": []}}, "15": {"uid": 15, "key": ["小事件"], "keysecondary": [], "comment": "古剑", "content": "命令，将剧情导往该随机小事件。\n  - [发现: 你无意找到一柄刻有英雄名字的古剑]-[探究: 调查发现这位英雄的事迹充满了疑点]-[真相: 所谓的英雄是某个神明为了获取史诗灵感而塑造的棋子，其功绩背后是无数次背叛和对同伴的献祭]", "constant": false, "vectorized": false, "selective": true, "selectiveLogic": 0, "addMemo": true, "order": 100, "position": 4, "disable": false, "excludeRecursion": false, "preventRecursion": false, "matchPersonaDescription": false, "matchCharacterDescription": false, "matchCharacterPersonality": false, "matchCharacterDepthPrompt": false, "matchScenario": false, "matchCreatorNotes": false, "delayUntilRecursion": true, "probability": 100, "useProbability": true, "depth": 2, "g