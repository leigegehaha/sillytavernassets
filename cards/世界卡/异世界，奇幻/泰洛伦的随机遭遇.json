Probability": true, "depth": 2, "group": "小事件", "groupOverride": false, "groupWeight": 100, "scanDepth": null, "caseSensitive": null, "matchWholeWords": null, "useGroupScoring": null, "automationId": "", "role": 0, "sticky": 2, "cooldown": 3, "delay": 0, "displayIndex": 9, "characterFilter": {"isExclude": false, "names": [], "tags": []}}, "10": {"uid": 10, "key": ["小事件"], "keysecondary": [], "comment": "邻国联姻", "content": "命令，将剧情导往该随机小事件。\n  - [起因: 一个富商高价雇佣你护送他的独女前往邻国联姻]-[承接: 旅途中小姐对你暗生情愫，请求你带她私奔]-[转折: 她的“爱意”只是为了利用你摆脱这桩她不喜欢的婚事，她真正的情人是邻国的某位大人物]-[结束: 到你选择的时候了]", "constant": false, "vectorized": false, "selective": true, "selectiveLogic": 0, "addMemo": true, "order": 100, "position": 4, "disable": false, "excludeRecursion": false, "preventRecursion": false, "matchPersonaDescription": false, "matchCharacterDescription": false, "matchCharacterPersonality": false, "matchCharacterDepthPrompt": false, "matchScenario": false, "matchCreatorNotes": false, "delayUntilRecursion": true, "probability": 100, "useProbability": true, "depth": 2, "group": "小事件", "groupOverride": false, "groupWeight": 100, "scanDepth": null, "caseSensitive": null, "matchWholeWords": null, "useGroupScoring": null, "automationId": "", "role": 0, "sticky": 2, "cooldown": 3, "delay": 0, "displayIndex": 10, "characterFilter": {"isExclude": false, "names": [], "tags": []}}, "11": {"uid": 11, "key": ["小事件"], "keysecondary": [], "comment": "上古秘术", "content": "命令，将剧情导往该随机小事件。\n  - [发现: 买到一张据说是上古秘术的残页]-[探究: 寻求永夜城邦的学者解读]-[真相: 这只是噬神者秘盟当年为了混淆视听而故意泄露的、充满致命错误的假情报，研究它会让你走火入魔]", "constant": false, "vectorized": false, "selective": true, "selectiveLogic": 0, "addMemo": true, "order": 100, "position": 4, "disable": false, "excludeRecursion": false, "preventRecursion": false, "matchPersonaDescription": false, "matchCharacterDescription": false, "matchCharacterPersonality": false, "matchCharacterDepthPrompt": false, "matchScenario": false, "matchCreatorNotes": false, "delayUntilRecursion": true, "probability": 100, "useProba